<Window x:Class="Dit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="DIT — Media Workspace" Icon="Assets/dit.ico" Width="1440" Height="920" MinWidth="1060" MinHeight="700" Style="{StaticResource AppWindowStyle}" Background="{StaticResource CanvasBrush}">
  <Grid Background="{StaticResource CanvasBrush}">
  <Grid x:Name="Shell" Background="{StaticResource CanvasBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource AccentBrush}" Margin="0,0,14,0"><TextBlock Text="D" Foreground="#102621" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="DIT" FontSize="22" FontWeight="Bold"/><TextBlock Text="MEDIA WORKSPACE" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox x:Name="Projects" Width="240" Margin="0,0,12,0" SelectionChanged="ProjectChanged" ToolTip="Bieżący projekt produkcji"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <Button Content="+  Nowy projekt" Style="{StaticResource PrimaryButton}" Click="NewProject" Margin="0,0,10,0"/>
          <Button Content="Wyloguj ze wszystkich kart" Style="{StaticResource QuietButton}" Click="LockAll" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="AccountsBar" Grid.Row="1" Background="#131922" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,8,28,0" Visibility="Collapsed">
      <StackPanel><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock x:Name="DaySummary" Text="Nie otwarto dnia zdjęciowego" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="15"/><TextBlock x:Name="DayRange" Foreground="{StaticResource MutedBrush}" Margin="18,2,0,0"/></StackPanel><TextBlock x:Name="PublicQueueState" Grid.Column="1" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" MaxWidth="420"/></Grid><TabControl x:Name="Tabs" Style="{StaticResource AccountTabs}" SelectionChanged="TabChanged"/></StackPanel>
    </Border>
    <Grid Grid.Row="2" Margin="28,14">
      <Grid x:Name="Locked">
        <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="34">
          <StackPanel>
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left" Margin="0,0,0,24"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock x:Name="EntryCaption" Text="TWOJA PRODUKCJA" Style="{StaticResource CaptionStyle}" Margin="0,0,0,10"/>
            <TextBlock x:Name="LoginTitle" Text="Zacznij od projektu" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="LoginDescription" Text="Utwórz przestrzeń dla produkcji, dodaj operatorów i wskaż miejsca zapisu materiału." Foreground="{StaticResource MutedBrush}" FontSize="14" LineHeight="22" TextWrapping="Wrap" Margin="0,12,0,26"/>
            <StackPanel x:Name="NoProjectActions"><Button Content="+  Utwórz pierwszy projekt" Style="{StaticResource PrimaryButton}" Click="NewProject" Margin="0" Padding="18,13"/><TextBlock Text="Masz już projekt? Wybierz go z listy u góry." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0"/></StackPanel>
            <StackPanel x:Name="LoginForm" Visibility="Collapsed"><TextBlock Text="Hasło do zakładki (jeśli ustawiono)" Margin="0,0,0,8" FontWeight="SemiBold"/><PasswordBox x:Name="LoginPassword" KeyDown="LoginKeyDown"/><Button Content="Odblokuj zakładkę  →" Style="{StaticResource PrimaryButton}" Click="Login" Margin="0,16,0,0" Padding="18,13"/></StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="Workspace" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" x:Name="ContextTitle" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="BackToTiles" Grid.Column="0" Content="← Panel administratora" Click="AdminHome" Visibility="Collapsed" Margin="0,0,12,0"/><Button Grid.Column="2" Content="Zmień hasło" Style="{StaticResource QuietButton}" Click="ChangePassword" Margin="0"/></Grid>
        <Border x:Name="IngestBar" Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,12">
          <StackPanel><Grid x:Name="IngestControls"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Source" ToolTip="Karta lub folder źródłowy" Margin="0,0,10,0"/><ComboBox x:Name="AudioTrack" Grid.Column="1" Width="220" Visibility="Collapsed" Margin="0,0,10,0" SelectionChanged="AudioSourceSelected" DropDownOpened="AudioSourcesOpened" ToolTip="Wybierz urządzenie, z którego zgrywasz dźwięk. Nazwa określa folder i ścieżkę Premiere."><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="2" Content="Wybierz folder…" Click="SelectSource" Margin="0,0,10,0"/><Button x:Name="AudioFiles" Grid.Column="3" Content="Pliki…" Click="SelectAudioFiles" Visibility="Collapsed" Margin="0,0,10,0" ToolTip="Wybierz pliki wybranego mikroportu. Pozostałe pliki na karcie pozostaną nietknięte."/><Button x:Name="StartIngestButton" Grid.Column="4" Content="↓  Rozpocznij zgrywanie" Style="{StaticResource PrimaryButton}" Click="StartIngest" Margin="0"/></Grid><TextBlock x:Name="AudioSourceHint" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        </Border>
        <Grid Grid.Row="2">
          <ScrollViewer x:Name="AdminDashboard" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="Wybierz sekcję" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/><WrapPanel x:Name="DashboardTiles"/></StackPanel></ScrollViewer>
          <Border x:Name="AdminDetail" Visibility="Collapsed" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><Grid>
            <Grid x:Name="OverviewSection" Visibility="Collapsed"><ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="OverviewMouseWheel"><StackPanel Margin="0,0,12,0">
              <TextBlock x:Name="AdminSummary" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,8"/>
              <TextBlock x:Name="QueueSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,24"/>
              <TextBlock Text="Statystyki urządzeń" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <DataGrid x:Name="StatsGrid" AutoGenerateColumns="False" ScrollViewer.VerticalScrollBarVisibility="Disabled"><DataGrid.Columns>
                <DataGridTextColumn Header="Urządzenie" Binding="{Binding Device}" Width="*" MinWidth="140"/><DataGridTextColumn Header="Nagrania" Binding="{Binding Clips}" Width="85"/><DataGridTextColumn Header="Czas nagrań" Binding="{Binding Duration}" Width="115"/><DataGridTextColumn Header="Oryginały" Binding="{Binding Original}" Width="115"/><DataGridTextColumn Header="Backup" Binding="{Binding Backup}" Width="115"/><DataGridTextColumn Header="Proxy" Binding="{Binding Proxy}" Width="110"/>
              </DataGrid.Columns></DataGrid>
              <TextBlock Text="Magazyny" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
              <DataGrid x:Name="VolumesGrid" AutoGenerateColumns="False" ScrollViewer.VerticalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2*" MinWidth="200"/><DataGridTextColumn Header="Fizyczny dysk" Binding="{Binding Disk}" Width="120"/><DataGridTextColumn Header="Wolne miejsce" Binding="{Binding Free}" Width="130"/><DataGridTextColumn Header="Stan" Binding="{Binding Status}" Width="*" MinWidth="140"/></DataGrid.Columns></DataGrid>
              <TextBlock Text="Premiere / proxy" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
              <DataGrid x:Name="AdobeGrid" AutoGenerateColumns="False" ScrollViewer.VerticalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="Operacja" Binding="{Binding Operation}" Width="*" MinWidth="200"/><DataGridTextColumn Header="Stan" Binding="{Binding State}" Width="160"/><DataGridTemplateColumn Header="Postęp" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8" Margin="12,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Informacja" Binding="{Binding Info}" Width="2*" MinWidth="240"/></DataGrid.Columns></DataGrid>
            </StackPanel></ScrollViewer></Grid>
            <Grid x:Name="AlertsSection" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Wyjaśniony alert oznacza zamkniętą sprawę z notatką administratora. Nie wznawia kolejki ani nie potwierdza bezpieczeństwa kopii." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <WrapPanel><Button Content="Notatka do alertu" Click="AlertNote"/><Button Content="Oznacz jako wyjaśniony" Click="ResolveAlert"/><Button Content="Otwórz ponownie" Click="ReopenAlert"/></WrapPanel>
              </StackPanel>
              <DataGrid x:Name="AlertsGrid" Grid.Row="1" AutoGenerateColumns="False" RowHeight="NaN" MinRowHeight="46"><DataGrid.Columns>
                <DataGridTextColumn Header="Kiedy" Binding="{Binding AtText}" SortMemberPath="At" Width="150"/>
                <DataGridTextColumn Header="Zakładka" Binding="{Binding Tab}" Width="105"/>
                <DataGridTemplateColumn Header="Karta / źródło" SortMemberPath="Source" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Source}" ToolTip="{Binding SourceDetails}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Komunikat" Binding="{Binding Message}" ElementStyle="{StaticResource ActivityCellText}" Width="2*" MinWidth="250"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Notatka / zamknięcie" Binding="{Binding Note}" ElementStyle="{StaticResource ActivityCellText}" Width="*" MinWidth="200"/>
              </DataGrid.Columns></DataGrid>
            </Grid></Grid>
            <Grid x:Name="HistorySection" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel><WrapPanel Margin="0,4,0,0">
                <StackPanel Margin="0,0,12,10"><TextBlock Text="Poziom" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/><ComboBox x:Name="HistoryLevel" Width="120" SelectionChanged="HistoryFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,12,10"><TextBlock Text="Operacja" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/><ComboBox x:Name="HistoryAction" Width="145" SelectionChanged="HistoryFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,12,10"><TextBlock Text="Zakładka" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/><ComboBox x:Name="HistoryTab" Width="105" SelectionChanged="HistoryFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,12,10"><TextBlock Text="Od dnia" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/><DatePicker x:Name="HistoryFrom" Width="110" SelectedDateChanged="HistoryFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,12,10"><TextBlock Text="Do dnia" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/><DatePicker x:Name="HistoryTo" Width="110" SelectedDateChanged="HistoryFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,12,10"><TextBlock Text="Szukaj w historii" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6"/><TextBox x:Name="HistorySearch" Width="170" TextChanged="HistorySearchChanged"/></StackPanel>
                <Button Content="Wyczyść filtry" Click="ClearHistoryFilters" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
              </WrapPanel><TextBlock x:Name="HistoryCount" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/></StackPanel>
              <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" RowHeight="NaN" MinRowHeight="46" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns>
                <DataGridTemplateColumn Header="Typ" SortMemberPath="Level" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Icon}" Foreground="{Binding Color}" ToolTip="{Binding Level}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Kiedy" Binding="{Binding AtText}" SortMemberPath="At" Width="150"/>
                <DataGridTextColumn Header="Zakładka" Binding="{Binding Tab}" Width="100"/>
                <DataGridTextColumn Header="Kto" Binding="{Binding Actor}" Width="100"/>
                <DataGridTextColumn Header="Operacja" Binding="{Binding Action}" Width="170"/>
                <DataGridTemplateColumn Header="Karta / źródło" SortMemberPath="Source" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Source}" ToolTip="{Binding SourceDetails}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Szczegóły" Binding="{Binding Detail}" ElementStyle="{StaticResource ActivityCellText}" Width="*" MinWidth="240"/>
              </DataGrid.Columns></DataGrid>
            </Grid></Grid>
            <ScrollViewer x:Name="DaysSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Dni zdjęciowe" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Dzień otwiera i zamyka administrator. Starsze nagrania zachowują dzień wynikający z metadanych; pozostałe trafiają do dnia wybranego przy starcie zgrywania." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/><WrapPanel><Button Content="Otwórz dzień" Click="OpenDay" Style="{StaticResource PrimaryButton}"/><Button Content="Zamknij dzień" Click="CloseDay"/></WrapPanel><DataGrid x:Name="DaysGrid" AutoGenerateColumns="False" Margin="0,20,0,0" SelectionChanged="DaySelected"><DataGrid.Columns><DataGridTextColumn Header="Dzień" Binding="{Binding Dzień}" Width="80"/><DataGridTextColumn Header="Stan" Binding="{Binding Stan}" Width="130"/><DataGridTextColumn Header="Początek" Binding="{Binding Początek}" Width="190"/><DataGridTextColumn Header="Koniec" Binding="{Binding Koniec}" Width="*"/></DataGrid.Columns></DataGrid>
<TextBlock x:Name="DayStatisticsSummary" Text="Wybierz dzień, aby zobaczyć jego podsumowanie." FontSize="18" TextWrapping="Wrap" Margin="0,24,0,16"/>
<DataGrid x:Name="DayCardsGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Karta / folder źródłowy" Binding="{Binding Source}" Width="2*" MinWidth="200"/><DataGridTextColumn Header="Zakładka" Binding="{Binding Tab}" Width="120"/><DataGridTextColumn Header="Nagrania" Binding="{Binding Clips}" Width="85"/><DataGridTextColumn Header="Czas materiału" Binding="{Binding Duration}" Width="120"/><DataGridTextColumn Header="Rozmiar" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="Początek zgrywania" Binding="{Binding Started}" Width="160"/><DataGridTextColumn Header="ID zgrywania" Binding="{Binding BatchId}" Width="*" MinWidth="170"/></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer>
            <StackPanel x:Name="AdobeSection" Visibility="Collapsed"><TextBlock Text="Premiere i proxy" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Panel zapamiętuje połączenie i ponawia je automatycznie. Cała produkcja ma jeden projekt Premiere. Otwarcie dnia tworzy jego osobną sekwencję. Przycisk poniżej instaluje panel. W Premiere otwórz Okno → UXP Plugins → DIT i jednorazowo wybierz plik połączenia. Proxy wymaga presetu AME wskazanego w konfiguracji." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/><TextBlock x:Name="AdobeConnectionStatus" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/><WrapPanel><Button Content="Skonfiguruj / otwórz Adobe" Click="AdobeKey" ToolTip="Zainstaluj panel DIT i otwórz Premiere. Przy pierwszym użyciu wybierz plik połączenia w panelu. Kolejne połączenia są zapamiętane."/><Button Content="Zatwierdź spóźnione zgrywanie" Click="Approve"/></WrapPanel></StackPanel>
          </Grid></Border>
          <ContentControl x:Name="ConfigurationHost" Visibility="Collapsed"/><Grid x:Name="FootageWorkspace" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="4*" MinWidth="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2.5*" MinWidth="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3.5*" MinWidth="250"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="Nagrania" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/><StackPanel Grid.Row="1"><WrapPanel Margin="0,0,0,6"><ComboBox x:Name="AssetStage" Width="190" Margin="0,0,6,6" SelectionChanged="AssetFilterChanged" ToolTip="Filtruj według etapu. W toku obejmuje kopie, proxy i import; synchronizacja ma osobny filtr."/><ComboBox x:Name="AssetSort" Width="165" Margin="0,0,0,6" SelectionChanged="AssetSortChanged" ToolTip="Sortowanie nagrań"/></WrapPanel><TextBlock Text="Szukaj nazwy pliku lub właściciela" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/><TextBox x:Name="AssetSearch" TextChanged="AssetSearchChanged" ToolTip="Szukaj nazwy pliku lub właściciela" Margin="0,0,0,8"/><TextBlock x:Name="AssetsSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
              <Grid Grid.Row="2"><DataGrid x:Name="AssetsGrid" AutoGenerateColumns="False" RowHeight="NaN" MinRowHeight="86" SelectionChanged="AssetSelected"><DataGrid.Columns><DataGridTemplateColumn Header="Nazwa pliku / etapy" SortMemberPath="LogicalName" Width="*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,8"><TextBlock Text="{Binding LogicalName}" ToolTip="{Binding LogicalName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" ToolTip="{Binding Error}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding Stages}" ToolTip="{Binding StageDetails}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" FontSize="10"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn x:Name="OwnerColumn" Header="Właściciel" Binding="{Binding Owner}" Width="95"/><DataGridTextColumn Header="Rozmiar" Binding="{Binding Size}" SortMemberPath="Asset.Bytes" Width="85"/><DataGridTextColumn Header="Czas" Binding="{Binding Duration}" SortMemberPath="SortDuration" Width="75"/>
</DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyAssetsHint" Text="Brak nagrań. Wybierz kartę, aby rozpocząć zgrywanie." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False"/></Grid>
            </Grid></Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{StaticResource LineBrush}" ResizeBehavior="PreviousAndNext"/>
            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="Zgrywania" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <WrapPanel x:Name="AdminQueueButtons" Grid.Row="1" Visibility="Collapsed"><Button Content="Wstrzymaj" Click="Pause" Padding="10,6"/><Button Content="Wznów" Click="Resume" Padding="10,6"/></WrapPanel>
              <DataGrid x:Name="BatchesGrid" Grid.Row="2" AutoGenerateColumns="False" RowHeight="NaN" MinRowHeight="120" HeadersVisibility="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Owner}" FontWeight="SemiBold"/><TextBlock Text="{Binding Source}" ToolTip="{Binding Source}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6"/><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding Indeterminate}" Height="6" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="{Binding Error}" Foreground="#FF9292" TextWrapping="Wrap" FontSize="12"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
            </Grid></Border>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="{StaticResource LineBrush}" ResizeBehavior="PreviousAndNext"/>
            <Border x:Name="PreviewPanel" Grid.Column="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="Podgląd" FontSize="18" FontWeight="SemiBold"/>
              <Border Grid.Row="1" Background="#0A0E14" CornerRadius="7" Margin="0,14,0,12"><Grid><Image x:Name="Thumbnail" Visibility="Collapsed" Stretch="Uniform"/><vlc:VideoView x:Name="Video" Visibility="Collapsed"/><TextBlock x:Name="PreviewHint" Text="Wybierz nagranie z listy" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="20"/></Grid></Border>
              <Slider x:Name="Seek" Grid.Row="2" Maximum="1000" IsMoveToPointEnabled="True" ValueChanged="SeekValueChanged" PreviewMouseDown="SeekBegin" PreviewMouseUp="SeekEnd" ToolTip="Przesuń, aby zobaczyć klatkę w wybranym miejscu"/>
              <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PlaybackTime" Text="00:00 / 00:00" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox x:Name="PlaybackSpeed" Grid.Column="1" Width="72" SelectionChanged="SpeedChanged" ToolTip="Prędkość odtwarzania" SelectedIndex="0"><ComboBoxItem Content="1×"/><ComboBoxItem Content="1,5×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="3×"/><ComboBoxItem Content="4×"/></ComboBox></Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"><Button Content="◀◀" Click="PreviousClip" Padding="10,6" ToolTip="Poprzednie nagranie"/><Button x:Name="PlayPauseButton" Content="▶" Click="TogglePlay" Padding="14,6" Style="{StaticResource PrimaryButton}"/><Button Content="▶▶" Click="NextClip" Padding="10,6" ToolTip="Następne nagranie"/></StackPanel>
              </StackPanel>
              <TextBlock x:Name="PreviewStatus" Grid.Row="4" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </Grid></Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="#121821" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DockPanel VerticalAlignment="Center"><TextBlock DockPanel.Dock="Left" Text="●" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="Łączenie z procesem roboczym…" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Grid.Column="1" Text="DIT  /  MEDIA WORKSPACE" Style="{StaticResource CaptionStyle}" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
  </Grid>
    <Border x:Name="StartupOverlay" Background="{StaticResource CanvasBrush}" Visibility="Collapsed">
      <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="DIT" Foreground="{StaticResource AccentBrush}" FontSize="54" FontWeight="Bold" Margin="0,0,0,24"/>
        <TextBlock x:Name="StartupTitle" Text="Uruchamianie programu" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="StartupDetail" Text="Łączenie z procesem roboczym…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,22"/>
        <ProgressBar x:Name="StartupProgress" Height="6" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="{StaticResource RaisedBrush}" BorderThickness="0"/>
        <Button x:Name="RetryStartupButton" Content="Spróbuj ponownie" Click="RetryStartup" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,24,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
